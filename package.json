{
  "name": "offline-invoice-scanner",
  "private": true,
  "version": "1.0.0",
  "description": "Offline-first PWA that scans paper invoices with on-device OCR, builds a delivery note, and syncs when the connection returns.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "prepare-assets": "node scripts/copy-ocr-assets.mjs",
    "postinstall": "node scripts/copy-ocr-assets.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "make:icons": "node scripts/make-icons.mjs",
    "make:samples": "node scripts/make-samples.mjs",
    "ci": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "idb": "^8.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "pwa",
    "offline-first",
    "ocr",
    "tesseract",
    "react",
    "vite",
    "tailwind",
    "invoice",
    "indexeddb",
    "service-worker"
  ]
}
